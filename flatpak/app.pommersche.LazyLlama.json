{
  "id": "app.pommersche.LazyLlama",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "lazyllama",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=host"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/lazyllama/cargo"
    }
  },
  "modules": [
    {
      "name": "lazyllama",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --verbose",
        "install -Dm755 ./target/release/lazyllama -t /app/bin/",
        "install -Dm644 LICENSE /app/share/licenses/lazyllama/LICENSE",
        "install -Dm644 README.md /app/share/doc/lazyllama/README.md",
        "install -Dm644 app.pommersche.LazyLlama.metainfo.xml /app/share/metainfo/app.pommersche.LazyLlama.metainfo.xml"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/Pommersche92/lazyllama/archive/refs/tags/v0.4.1.tar.gz",
          "sha256": "PLACEHOLDER_REPLACE_WITH_SCRIPT"
        },
        {
          "type": "file",
          "path": "app.pommersche.LazyLlama.metainfo.xml"
        },
        "generated-sources.json"
      ]
    }
  ]
}
